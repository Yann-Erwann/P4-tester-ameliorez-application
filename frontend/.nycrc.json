{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": [
    "src/app/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ],
  "temp-dir": "coverage/e2e/.nyc_output",
  "report-dir": "coverage/e2e",
  "reporter": [
    "text",
    "html",
    "lcov",
    "json",
    "json-summary"
  ],
  "check-coverage": true,
  "statements": 80,
  "branches": 80,
  "functions": 80,
  "lines": 80
}
